# Kuaforum PRODUCTION environment. Copy to `.env.prod`, fill in real values,
# NEVER commit `.env.prod` (already gitignored). This file only ever holds
# placeholders/examples.
#
# Every command against docker-compose.prod.yml must pass --env-file explicitly
# (the file is not named `.env`, so Compose won't auto-load it):
#   docker compose --env-file .env.prod -f docker-compose.prod.yml config
#   docker compose --env-file .env.prod -f docker-compose.prod.yml pull
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# Full description of every var (required vs optional, what breaks if missing)
# is in infra/README.md § "Zorunlu environment değişkenleri".

# ---- Domains / TLS -----------------------------------------------------------
API_DOMAIN=api.kuaforum.com
ADMIN_DOMAIN=admin.kuaforum.com
ACME_EMAIL=ops@kuaforum.com

# ---- Images (GHCR) -------------------------------------------------------------
GHCR_NAMESPACE=ghcr.io/kuaforum
IMAGE_TAG=latest

# ---- Postgres -------------------------------------------------------------------
POSTGRES_USER=kuaforum
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
POSTGRES_DB=kuaforum_prod

# ---- Redis ------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32

# ---- Backend (.NET) — native hierarchical env override, Section__Key ---------------
# These land directly in the backend container via `env_file:` in
# docker-compose.prod.yml, so the double-underscore names below must match
# appsettings.*.json section/key names EXACTLY (case-insensitive).
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=kuaforum_prod;Username=kuaforum;Password=CHANGE_ME_same_as_POSTGRES_PASSWORD_above
ConnectionStrings__Redis=redis:6379,password=CHANGE_ME_same_as_REDIS_PASSWORD_above

Jwt__SigningKey=CHANGE_ME_min_32_bytes_openssl_rand_base64_48
Otp__Pepper=CHANGE_ME_openssl_rand_base64_32
Encryption__Key=CHANGE_ME_openssl_rand_base64_32

# SMS (NetGSM) — leave blank until the founder opens a NetGSM merchant account.
# Blank in Production = SMS send returns false + Error log (code is NEVER logged),
# it does NOT silently fall back to mock/log-the-code behavior. See
# backend/src/Kuaforum.Infrastructure/Auth/NetGsmSmsService.cs.
NetGsm__UserCode=
NetGsm__Password=
NetGsm__Originator=KUAFORUM

# Email (Resend) — leave blank to fall back to log-only mock (no crash, just no email sent).
Resend__ApiKey=

# Push (FCM) — path must match a file mounted into the container (see
# docker-compose.prod.yml backend.volumes). Leave FCM__ServiceAccountJson set
# instead if you'd rather inject the raw JSON as an env var.
Fcm__ServiceAccountJsonPath=/secrets/firebase-sa.json

# Payment (PayTR) — leave blank until the founder has a live merchant account;
# payment attempts will fail at request time, not at boot.
PayTr__MerchantId=
PayTr__MerchantKey=
PayTr__MerchantSalt=

# Admin bootstrap — set ONCE to create the first admin user, then either unset
# Seed__Admin__Password or leave both set (AdminSeeder is idempotent: it only
# ever creates an admin if none exists yet, see AdminSeeder.SeedAsync).
Seed__Admin__Email=
Seed__Admin__Password=

# Observability
Sentry__Dsn=
Seq__ApiKey=

AllowedHosts=api.kuaforum.com

# ---- Web admin (Next.js) — build-time only, baked into the JS bundle ------------
NEXT_PUBLIC_API_BASE_URL=https://api.kuaforum.com

# ---- Backup sidecar ---------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
