# Kuaforum local dev environment variables. Copy to .env and adjust.

# Backend (.NET API)
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=kuaforum_dev;Username=kuaforum;Password=devpassword;Include Error Detail=true
ConnectionStrings__Redis=localhost:6379
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:8081

# Mobile (Expo)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_SENTRY_DSN=

# Web admin (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_SENTRY_DSN=

# Meilisearch (dev only)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev_master_key_change_me

# Seq (logging)
SEQ_URL=http://localhost:5341

# Third-party (stub for dev — replace with sandbox credentials in staging)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
NILVERA_API_KEY=
NETGSM_USERCODE=
NETGSM_PASSWORD=
GOOGLE_MAPS_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=
SENTRY_DSN=
