{
  "ConnectionStrings": {
    "Postgres": "${POSTGRES_CONNECTION_STRING}",
    "Redis": "${REDIS_CONNECTION_STRING}"
  },
  "Jwt": {
    "Issuer": "${JWT_ISSUER:kuaforum}",
    "Audience": "${JWT_AUDIENCE:kuaforum-clients}",
    "SigningKey": "${JWT_SIGNING_KEY}",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "Otp": {
    "Pepper": "${OTP_PEPPER}"
  },
  "Encryption": {
    "Key": "${ENCRYPTION_KEY}"
  },
  "Sms": {
    "Provider": "${SMS_PROVIDER:netgsm}"
  },
  "NetGsm": {
    "Username": "${NETGSM_USERNAME}",
    "Password": "${NETGSM_PASSWORD}",
    "Header": "${NETGSM_HEADER}"
  },
  "Email": {
    "Provider": "${EMAIL_PROVIDER:resend}"
  },
  "Resend": {
    "ApiKey": "${RESEND_API_KEY}",
    "FromAddress": "${RESEND_FROM:Kuaforum <noreply@kuaforum.app>}"
  },
  "Fcm": {
    "ServiceAccountJsonPath": "${FCM_SERVICE_ACCOUNT_JSON_PATH:/secrets/firebase-sa.json}"
  },
  "Payment": {
    "DefaultProvider": "${PAYMENT_PROVIDER:paytr}"
  },
  "PayTr": {
    "MerchantId": "${PAYTR_MERCHANT_ID}",
    "MerchantKey": "${PAYTR_MERCHANT_KEY}",
    "MerchantSalt": "${PAYTR_MERCHANT_SALT}",
    "Sandbox": false
  },
  "Seed": {
    "Demo": false,
    "ComprehensiveDemo": false
  },
  "Sentry": {
    "Dsn": "${SENTRY_DSN}",
    "Environment": "${SENTRY_ENVIRONMENT:production}",
    "TracesSampleRate": 0.1,
    "AttachStacktrace": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.kuaforum.com",
      "https://admin.kuaforum.com"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "${SEQ_URL:http://seq:5341}",
          "apiKey": "${SEQ_API_KEY}"
        }
      }
    ]
  },
  "AllowedHosts": "${ALLOWED_HOSTS:api.kuaforum.com}"
}
