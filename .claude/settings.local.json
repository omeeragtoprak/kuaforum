{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Project-level Claude Code settings for Kuaforum. Allowlist common read-only commands to reduce permission prompts. Destructive operations require explicit user approval each time.",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git stash list)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore)",
      "Bash(dotnet ef migrations list)",
      "Bash(dotnet ef migrations script:*)",
      "Bash(pnpm install)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(npm test:*)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(dotnet ef database drop:*)",
      "Bash(docker system prune:*)",
      "Bash(redis-cli FLUSHALL:*)"
    ]
  }
}
