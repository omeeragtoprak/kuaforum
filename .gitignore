# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Environment — ignore every .env* file EXCEPT the checked-in *.example templates.
# Broadened from the previous .env / .env.local / .env.*.local-only pattern,
# which did NOT match infra/.env.prod (added alongside this) — that filename
# would have been committable by accident under the old rule.
.env*
!.env.example
!.env.*.example
!*.env.example

